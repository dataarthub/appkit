{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!llms.txt",
        "!llms-full.txt",
        "!docs/exports.md",
        "!docs/index.md",
        "!consumer-ai/package-context.json",
        "!consumer-ai/api-index.json",
        "!docs/ai-errors.md"
      ],
      "outputs": [
        "dist/**",
        "llms.txt",
        "llms-full.txt",
        "docs/exports.md",
        "docs/index.md",
        "consumer-ai/package-context.json",
        "consumer-ai/api-index.json",
        "docs/ai-errors.md"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!llms.txt",
        "!llms-full.txt",
        "!consumer-ai/package-context.json",
        "!consumer-ai/api-index.json"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!llms.txt",
        "!llms-full.txt",
        "$TURBO_ROOT$/scripts/test-unit.mjs",
        "$TURBO_ROOT$/scripts/vitest.config.ts",
        "!consumer-ai/package-context.json",
        "!consumer-ai/api-index.json"
      ]
    },
    "@alneas/appkit-react#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!llms.txt",
        "!llms-full.txt",
        "!docs/exports.md",
        "!docs/index.md",
        "$TURBO_ROOT$/scripts/generate-notices.mjs",
        "!THIRD_PARTY_NOTICES.md",
        "!src/tools/paraglide/**",
        "!consumer-ai/package-context.json",
        "!consumer-ai/api-index.json"
      ],
      "outputs": [
        "dist/**",
        "llms.txt",
        "llms-full.txt",
        "docs/exports.md",
        "docs/index.md",
        "THIRD_PARTY_NOTICES.md",
        "src/tools/paraglide/**",
        "consumer-ai/package-context.json",
        "consumer-ai/api-index.json"
      ]
    },
    "@alneas/appkit-react#test:browser": {
      "inputs": [
        "src/**",
        "stories/**",
        ".storybook/**",
        "public/**",
        "messages/**",
        "project.inlang/**",
        "*.config.*",
        "tsconfig*.json",
        "scripts/**",
        "dist/**",
        "$TURBO_ROOT$/packages/appkit-core/src/**",
        "$TURBO_ROOT$/packages/appkit-core/dist/**",
        "$TURBO_ROOT$/packages/appkit-core/package.json",
        "$TURBO_ROOT$/scripts/test-storybook.mjs",
        "$TURBO_ROOT$/scripts/verification/browser.mjs",
        "$TURBO_ROOT$/scripts/verification/story-selection.mjs",
        "$TURBO_ROOT$/scripts/lib/**",
        "$TURBO_ROOT$/bun.lock",
        "!src/tools/paraglide/README.md"
      ],
      "env": [
        "APPKIT_STORY_FILES",
        "CI",
        "APPKIT_TASK_RUNTIME",
        "APPKIT_CI_IMAGE",
        "NODE_ENV",
        "TZ",
        "NODE_OPTIONS"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    }
  },
  "globalDependencies": [
    "scripts/turbo.mjs",
    "scripts/generate-docs.mjs",
    "agent-policy.json",
    "scripts/agent/catalog-contract.mjs",
    "scripts/agent/generate-catalog.mjs",
    "scripts/build-agent-cli.mjs",
    "scripts/agent/cli.mjs",
    "scripts/agent/load-catalogs.mjs",
    "scripts/agent/search.mjs",
    "scripts/agent/generate-error-guide.mjs"
  ],
  "globalEnv": [
    "NODE_ENV",
    "TZ",
    "APPKIT_TASK_RUNTIME",
    "APPKIT_CI_IMAGE"
  ]
}
