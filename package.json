{
  "name": "appkit-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "turbo": "node scripts/turbo.mjs",
    "build": "node scripts/turbo.mjs run build",
    "test": "node scripts/turbo.mjs run test",
    "typecheck": "node scripts/turbo.mjs run typecheck",
    "verify": "node scripts/turbo.mjs run build typecheck test && bun run check:release && bun run check:docs",
    "check:release": "node --test scripts/release.test.mjs",
    "docs:generate": "node scripts/generate-docs.mjs",
    "check:docs": "bun run docs:generated && bun run docs:readmes && node --test scripts/check-docs.test.mjs && node scripts/check-docs.mjs",
    "test:consumer": "node scripts/check-consumer.mjs",
    "docs:readmes": "node --test scripts/check-readmes.test.mjs && node scripts/check-readmes.mjs",
    "docs:generated": "node --test scripts/check-generated.test.mjs scripts/generated-integration.test.mjs scripts/generate-docs-output.test.mjs && node scripts/check-generated.mjs",
    "test:agent-tooling": "node scripts/test-agent-tooling.mjs",
    "eval:agent": "node scripts/run-agent-eval.mjs",
    "check:agent-eval": "node scripts/check-agent-eval.mjs",
    "prepare": "husky",
    "hooks:install": "husky",
    "lint": "biome lint --no-errors-on-unmatched .",
    "format": "biome format --write",
    "lint:staged": "node scripts/workflow-supply/public/staged-gate.mjs lint",
    "secrets:setup": "node scripts/setup-gitleaks.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "secrets:staged": "node scripts/check-secrets.mjs --staged",
    "test:quality-tooling": "node --test scripts/quality-tooling.test.mjs",
    "test:npm-deployments": "node --test scripts/record-npm-deployments.test.mjs",
    "test:react-core-tooling": "node --test scripts/react-core/*.test.mjs",
    "test:publish-tooling": "node --test scripts/publish/*.test.mjs",
    "check:react-core": "node scripts/check-react-core.mjs",
    "check:quality": "bun run secrets:check && bun run lint && bun run test:quality-tooling && bun run test:npm-deployments && bun run test:react-core-tooling && bun run test:publish-tooling && bun run test:verification-tooling",
    "verify:push": "bun run quality:push",
    "storybook": "bun run storybook:prepare && bun run --cwd packages/appkit-react storybook",
    "build-storybook": "bun run storybook:prepare && bun run --cwd packages/appkit-react build-storybook",
    "check:storybook": "bun run storybook:prepare && node --test scripts/storybook.test.mjs scripts/guarded-process.test.mjs && bun run --cwd packages/appkit-react typecheck:storybook",
    "storybook:prepare": "bun run turbo run build --filter=@alneas/appkit-core && bun run --cwd packages/appkit-react generate:i18n",
    "test:storybook": "bun run storybook:prepare && node --test scripts/storybook.test.mjs scripts/guarded-process.test.mjs && node scripts/verification/browser.mjs",
    "verify:full": "node scripts/verification/run.mjs --full",
    "test:verification-tooling": "node --test scripts/verification/*.test.mjs && bun run test:workflow",
    "workflow:generate": "node scripts/workflow-supply/public/supply.mjs generate --project-root .",
    "workflow:check": "node scripts/workflow-supply/public/supply.mjs check --project-root .",
    "test:workflow": "node --test scripts/workflow-supply/public/*.test.mjs",
    "quality:commit": "node scripts/workflow-supply/public/staged-gate.mjs commit",
    "quality:push": "node scripts/workflow-adapter.mjs source",
    "quality:ci": "node scripts/workflow-adapter.mjs source",
    "conformance:check": "node scripts/workflow-supply/public/conformance.mjs check --project-root .",
    "conformance:verify": "node scripts/workflow-supply/public/conformance.mjs verify --project-root .",
    "conformance:audit": "node scripts/workflow-supply/public/policy-report.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "4.1.12",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "msw": "2.15.0",
    "playwright": "1.62.1",
    "storybook": "10.6.0",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  }
}
